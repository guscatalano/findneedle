<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FindNeedleUX.Pages.SearchLocationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FindNeedleUX.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:l="using:FindNeedleUX.ViewObjects"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:DataType="l:LocationListItem" x:Key="LocationTemplate">
            <Border Style="{StaticResource PageCard}" Padding="12,10" Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="2">
                    <SymbolIcon Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Symbol="Folder" Foreground="{ThemeResource SystemAccentColorBrush}" VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"/>

                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Bind Description}" Style="{StaticResource SecondaryText}"/>

                    <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Tag="{x:Bind Name}" Content="Edit" Width="70" Click="Button_Edit"
                                Visibility="{x:Bind EditVisibility}"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" AutomationProperties.HelpText="Edit this source"/>
                        <Button Tag="{x:Bind Name}" Content="Remove" Width="80" Click="Button_Remove"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" AutomationProperties.HelpText="Remove this source"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageHeading" Text="Sources" Style="{StaticResource PageHeading}"/>
                <TextBlock Text="The sources in your workspace — the folders, files, and logs this search looks through" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <Border Style="{StaticResource PageCard}">
                <Pivot>
                    <!-- Pivot headers default to 24px — the same size as the page heading, so the card
                         read as a second title. Card-title size instead. -->
                    <Pivot.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </Pivot.HeaderTemplate>
                    <!-- New: pick a source to add -->
                    <PivotItem Header="New">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="Local" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add folder" Click="Button_AddFolder"
                                        AutomationProperties.Name="Add folder source"/>
                                <Button Content="Add file" Click="Button_AddFile"
                                        AutomationProperties.Name="Add file source"/>
                                <Button Content="Add live Event Log" Click="Button_AddEventLog"
                                        ToolTipService.ToolTip="Read this machine's running Event Log channels (not a saved .evtx file — use Add File for those)"
                                        AutomationProperties.Name="Add live Windows Event Log source"/>
                            </StackPanel>

                            <TextBlock Text="Online sources" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="KustoButton" Content="Add Kusto" Click="Button_AddKusto"
                                        AutomationProperties.Name="Add Kusto cluster source"/>
                                <Button x:Name="AdoButton" Content="Add Azure DevOps" Click="Button_AddAdo"
                                        AutomationProperties.Name="Add Azure DevOps source"/>
                                <Button x:Name="GithubButton" Content="Add GitHub" Click="Button_AddGithub"
                                        AutomationProperties.Name="Add GitHub issues source"/>
                            </StackPanel>

                            <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                        Visibility="Collapsed" VerticalAlignment="Center">
                                <ProgressRing IsActive="True" Width="18" Height="18"/>
                                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </PivotItem>

                    <!-- Recent: one click to re-add a recently used file/folder -->
                    <PivotItem Header="Recent">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Recently used files &amp; folders" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="Keep" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <NumberBox Grid.Column="2" x:Name="RecentMaxBox" Minimum="1" Maximum="50" SpinButtonPlacementMode="Compact"
                                           Width="96" SmallChange="1" ValueChanged="RecentMax_ValueChanged"
                                           AutomationProperties.Name="How many recent sources to keep"/>
                                <Button Grid.Column="3" Content="Clear" Click="RecentClear_Click"/>
                            </Grid>
                            <StackPanel x:Name="RecentHost" Spacing="4"/>
                            <TextBlock x:Name="RecentEmpty" Text="No recent sources yet — add a folder or file and it'll show up here."
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </PivotItem>
                </Pivot>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Configured sources" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="EmptySourcesText" Visibility="Collapsed"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="No sources added yet — use New above to add a folder, file, or live Event Log."/>
                <ItemsRepeaterScrollHost>
                    <ScrollViewer>
                        <ItemsRepeater x:Name="VariedImageSizeRepeater"
                            ItemTemplate="{StaticResource LocationTemplate}">
                        </ItemsRepeater>
                    </ScrollViewer>
                </ItemsRepeaterScrollHost>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
