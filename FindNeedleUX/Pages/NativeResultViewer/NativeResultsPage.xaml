<Page
    x:Class="FindNeedleUX.Pages.NativeResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FindNeedleUX.Pages.NativeResultViewer"
    xmlns:pages="using:FindNeedleUX.Pages"
    xmlns:ctWinUI="using:CommunityToolkit.WinUI.UI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <local:TimeFormatConverter x:Key="TimeFmt"/>
        <local:SourcePathConverter x:Key="SourceTrim"/>
        <pages:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Filter-pane section header: quiet uppercase label above each group (Time / Level / Fields /
             Active filters / Quick rules). One style so the sections read as one list instead of each
             group inventing its own inline label ("Time:", "Filter:", "Level:"). -->
        <Style x:Key="PaneSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="60"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
        </Style>

        <!-- Grid cell text: align to the TOP of the (fixed-height) row so a multi-line value (e.g. a
             crash report with embedded newlines) reads top→bottom instead of centering its middle
             lines in the row and spilling over the neighbours. -->
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <!-- Rows are a fixed height (a user density preset). A Message with embedded newlines would
                 otherwise render as a tall multi-line block that the toolkit DataGridCell CENTERS in the
                 row — so a middle line shows instead of the first. Collapse every cell to a single line
                 (first line + ellipsis); the full text is still on the hover tooltip and the details panel.
                 ApplyRowFontSize() also gives the block a MinHeight = row height so its top-anchored line
                 sits at the TOP of the row. -->
            <Setter Property="MaxLines" Value="1"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Like GridCellText but reveals the cell's full text on hover — for columns whose content gets
             clipped at the cell edge (Message). So the compact row height stays, but nothing is hidden. -->
        <Style x:Key="GridCellTextTip" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="ToolTipService.ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <!-- Row details panel -->
        <DataTemplate x:Key="RowDetailsTemplate">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16" Margin="4">
                <StackPanel Spacing="6">
                    <TextBlock Text="Log entry details" FontSize="14" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="8" RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- VerticalAlignment=Top so the labels line up with the TOP of a tall, wrapping
                             Message/Source value instead of centering against it. -->
                        <TextBlock Grid.Row="0" Text="Index"    FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Index}" VerticalAlignment="Top" IsTextSelectionEnabled="True"/>
                        <TextBlock Grid.Row="1" Text="Time"     FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Time}" VerticalAlignment="Top" IsTextSelectionEnabled="True"/>
                        <TextBlock Grid.Row="2" Text="Provider" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Provider}" VerticalAlignment="Top" IsTextSelectionEnabled="True"/>
                        <TextBlock Grid.Row="3" Text="TaskName" FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TaskName}" VerticalAlignment="Top" IsTextSelectionEnabled="True"/>
                        <TextBlock Grid.Row="4" Text="Message"  FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Top" IsTextSelectionEnabled="True"/>
                        <TextBlock Grid.Row="5" Text="Source"   FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Source, Converter={StaticResource SourceTrim}}" TextWrapping="Wrap" VerticalAlignment="Top" IsTextSelectionEnabled="True"/>
                        <TextBlock Grid.Row="6" Text="Level"    FontWeight="SemiBold" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" VerticalAlignment="Top" IsTextSelectionEnabled="True"/>
                    </Grid>
                    <!-- Row actions, visible under the detail (the same actions as the row's right-click
                         menu, so nobody has to discover the context menu). Each handler reads the row
                         from the button's DataContext and opens a flyout anchored to it. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                        <Button Content="Filter in ▾" Height="28" FontSize="12" Padding="10,0" Click="RowDetailFilterIn_Click"
                                ToolTipService.ToolTip="Keep only rows whose field matches this row's value (adds a predicate to the search box)"/>
                        <Button Content="Filter out ▾" Height="28" FontSize="12" Padding="10,0" Click="RowDetailFilterOut_Click"
                                ToolTipService.ToolTip="Hide rows whose field matches this row's value (adds a predicate to the search box)"/>
                        <Button Content="Follow this activity" Height="28" FontSize="12" Padding="10,0"
                                Click="RowDetailFollowActivity_Click" Loaded="RowDetailFollowActivity_Loaded"/>
                        <Button Content="Tag ▾" Height="28" FontSize="12" Padding="10,0" Click="RowDetailTag_Click"
                                ToolTipService.ToolTip="Mark this row (Important / Question / Resolved / Note) and add a note"/>
                        <Button Content="Copy ▾" Height="28" FontSize="12" Padding="10,0" Click="RowDetailCopy_Click"
                                ToolTipService.ToolTip="Copy this row as JSON, CSV or XML"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar (full width) -->
            <RowDefinition Height="Auto"/>  <!-- Decode/explain banner -->
            <RowDefinition Height="*"/>     <!-- Body: optional left filter pane + main content -->
        </Grid.RowDefinitions>

        <!-- Banners (Grid.Row 1): streaming "still loading" + the why-is-this-empty decode banner. -->
        <StackPanel Grid.Row="1">
            <!-- Rule output files (diagrams/exports) were generated by this search. Custom Border (not
                 InfoBar) so the spacing is exactly what we set — no mystery template gaps. Collapsed
                 by default; shown via UpdateOutputFilesBanner(). -->
            <Border x:Name="OutputFilesBanner" Visibility="Collapsed"
                    Margin="0" Padding="12,8" CornerRadius="0"
                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    BorderThickness="0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock x:Name="OutputFilesBannerText" Grid.Column="1" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Text="Output files generated"/>
                    <Button Grid.Column="2" Content="View output files" Click="ViewOutputFiles_Click"/>
                    <Button Grid.Column="3" Click="DismissOutputFilesBanner_Click"
                            Background="Transparent" BorderThickness="0" Padding="6"
                            ToolTipService.ToolTip="Dismiss">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- THE one "what's happening" surface: shown while a streaming search is still producing
                 rows (count keeps rising) and/or the search index is building in the background. One
                 status line, one Refresh, one Stop — there is deliberately no second indicator on the
                 toolbar. Text comes from ViewModel.ProgressBannerText (ComposeProgressBanner). -->
            <InfoBar x:Name="StreamingBanner" IsClosable="False" Severity="Informational"
                     IsIconVisible="False" Margin="12,8,12,0"
                     Visibility="{x:Bind ViewModel.IsProgressBannerVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                     IsOpen="{x:Bind ViewModel.IsProgressBannerVisible, Mode=OneWay}">
                <InfoBar.Content>
                    <!-- Single compact row: animated loader icon · status text · Refresh · Stop. -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,2,0,6">
                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                            <Image x:Name="StreamGif" Stretch="Uniform" Visibility="Collapsed"/>
                            <ProgressRing x:Name="StreamRing" Width="20" Height="20" IsActive="True" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="ProgressBannerText" Text="{x:Bind ViewModel.ProgressBannerText, Mode=OneWay}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <Button Content="Refresh" Click="RefreshResults_Click" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.PendingRowsVisibility, Mode=OneWay}"
                                ToolTipService.ToolTip="Fold newly-loaded rows into your filtered view (paused while searching during load)"/>
                        <Button x:Name="ProgressStopButton" Click="StopProgressButton_Click" VerticalAlignment="Center"
                                AutomationProperties.Name="Stop loading"
                                ToolTipService.ToolTip="Stop loading rows (keeps what is loaded). When only the index is building, cancels the index build.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE71A;" FontSize="10"/>
                                <TextBlock Text="Stop"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- Why-is-this-empty banner (e.g. WPP ETL with missing symbols). Hidden unless set. -->
            <InfoBar x:Name="DecodeBanner" IsOpen="False" IsClosable="True" Visibility="Collapsed"
                     Severity="Warning" Margin="12,8,12,0">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
                        <Button x:Name="DecodeBannerSettings" Content="Resolve symbols…" Style="{StaticResource AccentButtonStyle}"
                                Click="DecodeBannerAction_Click"
                                ToolTipService.ToolTip="Open the WPP symbol-resolution page: point at your symbols, see per-binary status, and fix them"/>
                        <Button x:Name="DecodeBannerForce" Content="Decode anyway" Click="DecodeAnyway_Click"
                                ToolTipService.ToolTip="Decode whatever can be read, even if most events are unformatted"/>
                        <Button x:Name="DecodeBannerMore" Content="⋯" AutomationProperties.Name="More decode actions"
                                ToolTipService.ToolTip="More actions">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Copy missing symbol GUIDs" Click="DecodeBannerCopy_Click"/>
                                    <MenuFlyoutItem x:Name="DecodeBannerResolveItem" Text="Open resolution log"
                                                    Click="DecodeBannerResolve_Click" Visibility="Collapsed"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- search box: fills the empty space -->
                <ColumnDefinition Width="Auto"/>  <!-- ? help + search indicators -->
                <ColumnDefinition Width="Auto"/>  <!-- action buttons, pinned right -->
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Height="32" HorizontalAlignment="Stretch" Margin="0,0,8,0" MinWidth="160"
                         PlaceholderText="Search all columns…  (advanced query: press ?)"
                         TextChanged="SearchBox_TextChanged"
                         KeyDown="SearchBox_KeyDown"
                         GotFocus="SearchBox_GotFocus"
                         AutomationProperties.Name="Search results">
                    <ToolTipService.ToolTip>
                        <TextBlock>
                            <Run Text="Plain text searches all columns. Or use a query:"/><LineBreak/>
                            <Run FontFamily="Consolas" Text="  msg != &quot;this&quot; AND taskname == &quot;that&quot;"/><LineBreak/>
                            <Run FontFamily="Consolas" Text="  level == Error OR provider ~ Kernel"/><LineBreak/>
                            <Run FontFamily="Consolas" Text="  (pid == 1234 OR pid == 5678) AND NOT msg ~ debug"/><LineBreak/>
                            <Run Text="Operators: == != ~ (contains) !~ &gt; &lt; &gt;= &lt;=  ·  fields: msg, taskname, provider, source, level, pid, tid, eventid, channel, time, …"/>
                        </TextBlock>
                    </ToolTipService.ToolTip>
                </TextBox>
                <!-- Col1: ? help + search-state indicators, riding just right of the (filled) box. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- "?" opens the ONE viewer help surface (query syntax + filters + shortcuts) — the same
                     dialog as Help ▸ Viewer help (F1) and More ▸ Help. -->
                <Button x:Name="SearchHelpButton" Width="32" Height="32" Padding="0" Content="?" FontSize="14"
                        VerticalAlignment="Center" Click="HelpButton_Click"
                        AutomationProperties.Name="Viewer help"
                        ToolTipService.ToolTip="Viewer help: search &amp; query syntax, filters, shortcuts (F1)"/>
                <!-- Inline parse error when the box holds a malformed structured query. -->
                <TextBlock x:Name="SearchQueryErrorText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Visibility="Collapsed" MaxWidth="260" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Query error"/>
                <!-- Spins while a search runs off the UI thread (so the window never freezes). -->
                <ProgressRing x:Name="SearchBusyRing" Width="16" Height="16"
                              IsActive="False" Visibility="Collapsed"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Searching"/>
                <!-- Shown when the viewer is in Enter-to-search mode (large/slow log) so the user
                     knows mid-typing doesn't search. Hidden in live mode. -->
                <TextBlock x:Name="SearchHint" VerticalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"
                           AutomationProperties.Name="Search submit hint"/>
                </StackPanel>

                <!-- Col2: layout controls, then the action buttons, pinned to the right.
                     Left margin keeps a gap from the "?" so they don't collide. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Margin="16,0,0,0">
                <!-- Filters: Left | Top | Hide — the filter pane's placement, first-level (was View ▾ ▸
                     Filter pane). Left/Top set the dock; Hide collapses the pane. The active-filter
                     count rides on the label segment so hidden filters still announce themselves. -->
                <local:SegmentedControl x:Name="FiltersSegment" Label="Filters" Items="Left,Top,Hide"
                                        ItemToolTips="Filter pane docked left of the results,Filters as a row above the results,Hide the filter pane (filters stay applied)"
                                        SelectionChanged="FiltersSegment_SelectionChanged"
                                        AutomationProperties.Name="Filter pane placement"/>
                <!-- Details: In row | Panel | Popup — how a selected row's details show (was View ▾ ▸ Row details). -->
                <local:SegmentedControl x:Name="DetailsSegment" Label="Details" Items="In row,Panel,Popup"
                                        ItemToolTips="Click a row to expand its details inline,Docked panel below the grid shows the selected row,Double-click a row for a details dialog"
                                        SelectionChanged="DetailsSegment_SelectionChanged"
                                        AutomationProperties.Name="Row details mode"/>
                <!-- Rule filter: hide rows excluded by the active rule files. Its label says why it is
                     off when it cannot be enabled (no rule files / still loading) — see RuleFilterLabel. -->
                <ToggleButton x:Name="RuleFilterToggle" Height="32" IsEnabled="False"
                              Content="Rule filter (no rule files loaded)"
                              Click="RuleFilterToggle_Click"
                              AutomationProperties.Name="Rule filter"
                              ToolTipService.ToolTip="Hide rows excluded by the active rule files (from Workspace ▸ Rule files)"/>
                <Button x:Name="ColumnsButton" Content="Columns ▾" Height="32"
                        AutomationProperties.Name="Toggle column visibility">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="6" MinWidth="180">
                                <TextBlock Text="Columns" FontWeight="SemiBold" FontSize="13"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Columns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ColumnEntry">
                                            <CheckBox Content="{x:Bind Name}"
                                                      IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                                      Margin="0,2,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Optional viewer extras, grouped under the column toggles. The time
                                     strip is off-by-a-click here so users who misclick its bars can hide it. -->
                                <MenuFlyoutSeparator Margin="0,2"/>
                                <TextBlock Text="Show" FontWeight="SemiBold" FontSize="13"/>
                                <CheckBox x:Name="TimeStripColumnCheck" Content="Time strip (activity over time)"
                                          Checked="TimeStripColumnCheck_Changed" Unchecked="TimeStripColumnCheck_Changed"
                                          Margin="0,2,0,2"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <DropDownButton x:Name="ExportButton" Content="Export" Height="32"
                                AutomationProperties.Name="Export results">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Export as CSV"  Click="ExportCsv_Click"/>
                            <MenuFlyoutItem Text="Export as JSON" Click="ExportJson_Click"/>
                            <MenuFlyoutItem Text="Export as XML"  Click="ExportXml_Click"/>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="SourcesButton" Click="ShowLoadedSources_Click" Height="32"
                        AutomationProperties.AutomationId="SourcesButton"
                        AutomationProperties.Name="Show loaded sources and rules"
                        ToolTipService.ToolTip="See which sources and rule files this search loaded">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock x:Name="SourcesWarnGlyph" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="Sources"/>
                    </StackPanel>
                </Button>
                <!-- No loading / index indicator here on purpose: StreamingBanner (above the grid) is the
                     single progress surface with the single Stop (F10). -->
                <!-- Overflow: rarely-used Help + Settings -->
                <Button x:Name="OverflowButton" Height="32" VerticalAlignment="Center"
                        AutomationProperties.Name="More" ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="14"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="OverflowMenu" Placement="BottomEdgeAlignedRight" Opening="OverflowMenu_Opening">
                            <!-- Hidden-button entries are inserted here at the top when the menu opens. -->
                            <MenuFlyoutItem Text="Customize toolbar…" Click="CustomizeToolbar_Click"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Help" Click="HelpButton_Click"/>
                            <MenuFlyoutItem Text="Settings…" Click="SettingsButton_Click"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Body: an optional left-docked filter pane (Column 0) beside the main content (Column 1).
             The single FiltersPanel is re-parented between LeftFilterHost and TopFilterHost in code
             (RefreshFilterLayout) per the dock setting; its inner rows switch horizontal/vertical. -->
        <Grid Grid.Row="2" x:Name="BodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftFilterColumn" Width="Auto"/>  <!-- left filter pane (0 unless docked left; user-resizable) -->
                <ColumnDefinition Width="Auto"/>                            <!-- resize splitter (shown only in left dock) -->
                <ColumnDefinition Width="*"/>                              <!-- main content -->
            </Grid.ColumnDefinitions>

            <!-- Left-dock host: fills the resizable column; scrolls when the filters are taller than the viewport. -->
            <ScrollViewer x:Name="LeftFilterHost" Grid.Column="0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0"/>

            <!-- Drag-to-resize handle between the filter pane and the results (left dock only). -->
            <Border x:Name="FilterPaneSplitter" Grid.Column="1" Width="6" Visibility="Collapsed"
                    Background="Transparent"
                    PointerEntered="FilterPaneSplitter_PointerEntered" PointerExited="FilterPaneSplitter_PointerExited"
                    PointerPressed="FilterPaneSplitter_PointerPressed" PointerMoved="FilterPaneSplitter_PointerMoved"
                    PointerReleased="FilterPaneSplitter_PointerReleased" PointerCaptureLost="FilterPaneSplitter_PointerCaptureLost"
                    ToolTipService.ToolTip="Drag to resize the filter pane"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Top-dock filter host -->
                    <RowDefinition Height="*"/>     <!-- Grid + overlays -->
                    <RowDefinition Height="Auto"/>  <!-- Details panel -->
                    <RowDefinition Height="Auto"/>  <!-- Pagination bar -->
                </Grid.RowDefinitions>

                <!-- Top-dock host (default). FiltersPanel lives here initially. -->
                <ContentControl x:Name="TopFilterHost" Grid.Row="0" HorizontalContentAlignment="Stretch">

        <!-- Collapsible filter content: time range / per-column filter row / level chips. -->
        <Border x:Name="FiltersPanel"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- Time range -->
                <Border Padding="12,6"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel x:Name="TimeRowPanel" Orientation="Vertical" Spacing="6">
                        <TextBlock Text="TIME" Style="{StaticResource PaneSectionHeader}"/>
                        <!-- Quick relative presets (anchored to the log's latest event) + Custom toggle.
                             WrapPanelLite so the chips flow onto more lines in a narrow (left-dock) pane
                             instead of falling off the edge. -->
                        <local:WrapPanelLite x:Name="TimePresetPanel" HorizontalSpacing="6" VerticalSpacing="6">
                            <ToggleButton Content="15m" Tag="15"    Height="28" FontSize="12" Padding="8,0" Click="TimePreset_Click" ToolTipService.ToolTip="Last 15 minutes of the log"/>
                            <ToggleButton Content="1h"  Tag="60"    Height="28" FontSize="12" Padding="8,0" Click="TimePreset_Click" ToolTipService.ToolTip="Last hour of the log"/>
                            <ToggleButton Content="6h"  Tag="360"   Height="28" FontSize="12" Padding="8,0" Click="TimePreset_Click" ToolTipService.ToolTip="Last 6 hours of the log"/>
                            <ToggleButton Content="24h" Tag="1440"  Height="28" FontSize="12" Padding="8,0" Click="TimePreset_Click" ToolTipService.ToolTip="Last 24 hours of the log"/>
                            <ToggleButton Content="7d"  Tag="10080" Height="28" FontSize="12" Padding="8,0" Click="TimePreset_Click" ToolTipService.ToolTip="Last 7 days of the log"/>
                            <ToggleButton x:Name="TimePresetAll" Content="All" Tag="0" IsChecked="True" Height="28" FontSize="12" Padding="8,0" Click="TimePreset_Click" ToolTipService.ToolTip="No time filter (whole log)"/>
                        </local:WrapPanelLite>
                        <!-- Custom sits OUTSIDE the preset row on purpose. Styled as a chip alongside
                             15m/1h/…/All it read as a seventh PRESET, so the way to pick an exact range was
                             effectively invisible — it opens a From/To picker, it does not select a range by
                             itself. As a quiet link under the chips it reads as the different thing it is. -->
                        <ToggleButton x:Name="CustomTimeToggle" Height="26" FontSize="12" Padding="0"
                                      Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"
                                      Click="CustomTimeToggle_Click"
                                      AutomationProperties.Name="Custom range"
                                      ToolTipService.ToolTip="Pick an exact From/To date and time">
                            <TextBlock FontSize="12" Text="Custom range…"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        </ToggleButton>
                        <!-- Custom absolute range. Each bound stacks its date over its time so the 24h
                             TimePicker keeps enough width to show BOTH hour and minute (it clips to just
                             the hour when squeezed). The groups wrap to fit a narrow / resized pane. -->
                        <local:WrapPanelLite x:Name="CustomTimePanel" HorizontalSpacing="12" VerticalSpacing="8" Visibility="Collapsed">
                            <StackPanel Orientation="Vertical" Spacing="4">
                                <TextBlock Text="From" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <CalendarDatePicker x:Name="FromDatePicker" Width="170" PlaceholderText="From date"
                                                    DateChanged="FromDatePicker_DateChanged"/>
                                <DropDownButton x:Name="FromTimeButton" Width="170" HorizontalContentAlignment="Stretch"
                                                Content="Time: any"
                                                ToolTipService.ToolTip="Start time (optional). Empty = start of day; a time alone filters that minute on the log's day.">
                                    <DropDownButton.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="10" MinWidth="240">
                                                <TextBlock Text="From time" FontWeight="SemiBold"/>
                                                <TimePicker x:Name="FromTimePicker" ClockIdentifier="24HourClock" MinuteIncrement="1"
                                                            SelectedTimeChanged="FromTimePicker_SelectedTimeChanged"/>
                                                <Button Content="Clear time" Click="ClearFromTime_Click" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Spacing="4">
                                <TextBlock Text="To" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <CalendarDatePicker x:Name="ToDatePicker" Width="170" PlaceholderText="To date"
                                                    DateChanged="ToDatePicker_DateChanged"/>
                                <DropDownButton x:Name="ToTimeButton" Width="170" HorizontalContentAlignment="Stretch"
                                                Content="Time: any"
                                                ToolTipService.ToolTip="End time (optional). Empty = end of day; a set time includes that whole minute.">
                                    <DropDownButton.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="10" MinWidth="240">
                                                <TextBlock Text="To time" FontWeight="SemiBold"/>
                                                <TimePicker x:Name="ToTimePicker" ClockIdentifier="24HourClock" MinuteIncrement="1"
                                                            SelectedTimeChanged="ToTimePicker_SelectedTimeChanged"/>
                                                <Button Content="Clear time" Click="ClearToTime_Click" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                            <Button Content="Clear" Click="ClearTimeRange_Click" Height="32" VerticalAlignment="Bottom"/>
                        </local:WrapPanelLite>
                    </StackPanel>
                </Border>

                <!-- Level filter: click a chip to filter to that level (click again to clear). These chips
                     ARE the level filter (the old separate combo is hidden). Colors are edited on the
                     settings page (Settings → Appearance → Level colors), the single source of truth. -->
                <Border Padding="12,6"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="LEVEL" Style="{StaticResource PaneSectionHeader}"/>
                        <StackPanel x:Name="LevelsRowPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Levels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- Reflows the chips so they wrap in the narrow left-docked pane. -->
                                        <local:WrapPanelLite HorizontalSpacing="6" VerticalSpacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:LevelEntry">
                                        <ToggleButton IsChecked="{x:Bind IsSelected, Mode=OneWay}" Tag="{x:Bind Level}"
                                                      Click="LevelChip_Click" Padding="8,3" MinHeight="0" MinWidth="0" FontSize="12"
                                                      ToolTipService.ToolTip="Filter to this level (click again to clear)">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="12" Height="12" CornerRadius="2" BorderThickness="1"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        Background="{x:Bind HexColor, Mode=OneWay, Converter={StaticResource HexToBrush}}"/>
                                                <TextBlock Text="{x:Bind Level}" FontSize="12"/>
                                                <TextBlock Text="{x:Bind Count, Mode=OneWay}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Fields: one filter per column. -->
                <Border Padding="12,6"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="6">
                        <!-- Header row: section name + the two group-wide actions. Kept OUT of
                             FilterRowPanel so it stays one horizontal row when that panel flips to a
                             vertical stack in the left dock. -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="FIELDS" Style="{StaticResource PaneSectionHeader}" VerticalAlignment="Center"/>
                            <!-- Toggle: free-text boxes vs "known value" dropdowns for Provider/TaskName/Source. -->
                            <ToggleButton x:Name="ShowKnownToggle" Height="28" FontSize="12" Padding="8,0"
                                          Content="Pick from values" Checked="ShowKnownToggle_Toggled" Unchecked="ShowKnownToggle_Toggled"
                                          ToolTipService.ToolTip="Pick from the values actually present (Provider / TaskName / Source) instead of typing."/>
                            <Button Content="Clear fields" Click="ResetColumnFilters_Click" Height="28" FontSize="12"
                                    ToolTipService.ToolTip="Clear only the per-field filters (Provider, TaskName, Message, Source, Level) — leaves the search box and time range."/>
                        </StackPanel>
                        <StackPanel x:Name="FilterRowPanel" AutomationProperties.AutomationId="FilterRowPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Provider: text box OR known-value combo (one visible at a time; they share
                                 the Grid's middle column). A persistent field label (like SimpleEventViewer's
                                 sections) so it's clear which filter is which once a value is picked — the
                                 combo otherwise shows only the bare value. The X removes the whole field row;
                                 "+ Add field" (below) puts it back. -->
                            <Grid x:Name="ProviderFieldGroup" ColumnSpacing="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Provider" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Column="1" x:Name="ProviderFilterBox" AutomationProperties.AutomationId="ProviderFilterBox"
                                         Width="120" Height="28" FontSize="12" HorizontalAlignment="Left"
                                         PlaceholderText="Provider…" TextChanged="ProviderFilter_TextChanged"/>
                                <ComboBox Grid.Column="1" x:Name="ProviderFilterCombo" Width="200" Height="28" FontSize="12" Visibility="Collapsed"
                                          HorizontalAlignment="Left"
                                          DisplayMemberPath="Display" DropDownOpened="ProviderFilterCombo_DropDownOpened"
                                          PlaceholderText="Provider (known)…" SelectionChanged="ProviderFilterCombo_SelectionChanged"/>
                                <Button Grid.Column="2" Tag="provider" Content="&#x2715;" Click="RemoveField_Click"
                                        FontSize="10" Padding="5,0" MinWidth="0" MinHeight="0" Height="24"
                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Remove the Provider filter"
                                        ToolTipService.ToolTip="Stop filtering on Provider (add it back with + Add field)"/>
                                <DropDownButton Grid.Column="1" x:Name="ProviderFilterMulti" Height="28" FontSize="12" Visibility="Collapsed"
                                                HorizontalAlignment="Left"
                                                Content="Provider: All">
                                <DropDownButton.Flyout>
                                    <Flyout Opening="ProviderFlyout_Opening">
                                        <StackPanel MinWidth="260" Spacing="4">
                                            <Button Content="(All) — clear" Click="ProviderFilterAll_Click"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12"/>
                                            <ListView x:Name="ProviderFilterMultiList" SelectionMode="Multiple"
                                                      DisplayMemberPath="Display" MaxHeight="320"
                                                      SelectionChanged="ProviderFilterMultiList_SelectionChanged"/>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>
                            <Grid x:Name="TaskNameFieldGroup" ColumnSpacing="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TaskName" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Column="1" x:Name="TaskNameFilterBox" Width="140" Height="28" FontSize="12"
                                         HorizontalAlignment="Left"
                                         PlaceholderText="TaskName…" TextChanged="TaskNameFilter_TextChanged"/>
                                <ComboBox Grid.Column="1" x:Name="TaskNameFilterCombo" Width="200" Height="28" FontSize="12" Visibility="Collapsed"
                                          HorizontalAlignment="Left"
                                          DisplayMemberPath="Display" DropDownOpened="TaskNameFilterCombo_DropDownOpened"
                                          PlaceholderText="TaskName (known)…" SelectionChanged="TaskNameFilterCombo_SelectionChanged"/>
                                <Button Grid.Column="2" Tag="taskname" Content="&#x2715;" Click="RemoveField_Click"
                                        FontSize="10" Padding="5,0" MinWidth="0" MinHeight="0" Height="24"
                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Remove the TaskName filter"
                                        ToolTipService.ToolTip="Stop filtering on TaskName (add it back with + Add field)"/>
                                <DropDownButton Grid.Column="1" x:Name="TaskNameFilterMulti" Height="28" FontSize="12" Visibility="Collapsed"
                                                HorizontalAlignment="Left"
                                                Content="TaskName: All">
                                <DropDownButton.Flyout>
                                    <Flyout Opening="TaskNameFlyout_Opening">
                                        <StackPanel MinWidth="260" Spacing="4">
                                            <Button Content="(All) — clear" Click="TaskNameFilterAll_Click"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12"/>
                                            <ListView x:Name="TaskNameFilterMultiList" SelectionMode="Multiple"
                                                      DisplayMemberPath="Display" MaxHeight="320"
                                                      SelectionChanged="TaskNameFilterMultiList_SelectionChanged"/>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>
                            <Grid x:Name="MessageFieldGroup" ColumnSpacing="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Message" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Column="1" x:Name="MessageFilterBox" Width="220" Height="28" FontSize="12"
                                         HorizontalAlignment="Left"
                                         PlaceholderText="Message…" TextChanged="MessageFilter_TextChanged"/>
                                <Button Grid.Column="2" Tag="message" Content="&#x2715;" Click="RemoveField_Click"
                                        FontSize="10" Padding="5,0" MinWidth="0" MinHeight="0" Height="24"
                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Remove the Message filter"
                                        ToolTipService.ToolTip="Stop filtering on Message (add it back with + Add field)"/>
                            </Grid>
                            <Grid x:Name="SourceFieldGroup" ColumnSpacing="6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Source" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Column="1" x:Name="SourceFilterBox" Width="140" Height="28" FontSize="12"
                                         HorizontalAlignment="Left"
                                         PlaceholderText="Source…" TextChanged="SourceFilter_TextChanged"/>
                                <ComboBox Grid.Column="1" x:Name="SourceFilterCombo" Width="200" Height="28" FontSize="12" Visibility="Collapsed"
                                          HorizontalAlignment="Left"
                                          DisplayMemberPath="Display" DropDownOpened="SourceFilterCombo_DropDownOpened"
                                          PlaceholderText="Source (known)…" SelectionChanged="SourceFilterCombo_SelectionChanged"/>
                                <Button Grid.Column="2" Tag="source" Content="&#x2715;" Click="RemoveField_Click"
                                        FontSize="10" Padding="5,0" MinWidth="0" MinHeight="0" Height="24"
                                        Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                        AutomationProperties.Name="Remove the Source filter"
                                        ToolTipService.ToolTip="Stop filtering on Source (add it back with + Add field)"/>
                                <DropDownButton Grid.Column="1" x:Name="SourceFilterMulti" Height="28" FontSize="12" Visibility="Collapsed"
                                                HorizontalAlignment="Left"
                                                Content="Source: All">
                                <DropDownButton.Flyout>
                                    <Flyout Opening="SourceFlyout_Opening">
                                        <StackPanel MinWidth="260" Spacing="4">
                                            <Button Content="(All) — clear" Click="SourceFilterAll_Click"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="12"/>
                                            <ListView x:Name="SourceFilterMultiList" SelectionMode="Multiple"
                                                      DisplayMemberPath="Display" MaxHeight="320"
                                                      SelectionChanged="SourceFilterMultiList_SelectionChanged"/>
                                        </StackPanel>
                                    </Flyout>
                                </DropDownButton.Flyout>
                                </DropDownButton>
                            </Grid>
                            <!-- The level filter is now driven by the clickable Level chips below; this combo is
                                 kept (hidden) only as the backing control the existing filter code writes to. -->
                            <TextBlock Text="Level" Visibility="Collapsed" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                       Margin="6,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="LevelFilterCombo" Visibility="Collapsed" Width="170" Height="28" FontSize="12"
                                      PlaceholderText="Level (all)"
                                      ItemsSource="{x:Bind ViewModel.Levels, Mode=OneWay}"
                                      SelectionChanged="LevelFilterCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:LevelEntry">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="2" BorderThickness="1"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    Background="{x:Bind HexColor, Mode=OneWay, Converter={StaticResource HexToBrush}}"/>
                                            <TextBlock Text="{x:Bind Level}" FontSize="12"/>
                                            <TextBlock Text="{x:Bind Count, Mode=OneWay}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <!-- Add a filter on any other column the engine can filter (ProcessId,
                                 EventId, Channel…) — or put back one of the four above after removing
                                 it. The menu is built in code from FilterableFields. -->
                            <Button x:Name="AddFieldButton" Content="+ Add field" Height="28" FontSize="12" Padding="8,0"
                                    Click="AddFieldButton_Click" VerticalAlignment="Center"
                                    AutomationProperties.Name="Add a field filter"
                                    ToolTipService.ToolTip="Filter on another column"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Active filters: every constraint currently narrowing the view, one removable pill
                     each. Rendered in code from ActiveFilterCatalog.Build(BuildActiveFilterState()) —
                     the SAME list the Filters badge counts, so the number and the list can't disagree.
                     The whole section hides when nothing is active (there is then nothing to clear). -->
                <Border x:Name="ActiveFiltersSection" Padding="12,6" Visibility="Collapsed"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE FILTERS" Style="{StaticResource PaneSectionHeader}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ActiveFiltersCount" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <Button Content="Clear all" Click="ClearFiltersButton_Click"
                                    Height="24" FontSize="12" Padding="8,0" MinHeight="0"
                                    ToolTipService.ToolTip="Clear everything: the search box, per-field filters, time range, and level."
                                    AutomationProperties.Name="Clear all filters"/>
                        </StackPanel>
                        <local:WrapPanelLite x:Name="ActiveFiltersHost" HorizontalSpacing="6" VerticalSpacing="4"/>
                    </StackPanel>
                </Border>

                <!-- Quick rules: the session-only reshape rules made by right-clicking a column header.
                     They were invisible before this section existed — a rule could be rewriting every
                     Message with nothing on screen saying so. Rows are rendered in code
                     (RenderQuickRules); the section stays visible even when empty so "+ New quick rule"
                     is a discoverable way in, not just a hidden right-click. -->
                <Border x:Name="QuickRulesSection" Padding="12,6"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="QUICK RULES" Style="{StaticResource PaneSectionHeader}" VerticalAlignment="Center"/>
                            <TextBlock Text="this session" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <StackPanel x:Name="QuickRulesHost" Spacing="4"/>
                        <Button Content="+ New quick rule" Click="NewQuickRule_Click"
                                Height="26" MinHeight="0" FontSize="12" Padding="8,0" HorizontalAlignment="Left"
                                ToolTipService.ToolTip="Pull a value out of the Message into a column, or strip matching text — for this session only. (Same dialog as right-clicking a column header.)"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
                </ContentControl>

                <!-- DataGrid + overlays -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Time-density strip: event volume over the filtered set's time range. Click a bar
                         to zoom the time window to it. Hidden when there's no usable time range. -->
                    <Border x:Name="TimeStripHost" Grid.Row="0" Visibility="Collapsed" Height="46"
                            BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid>
                            <Canvas x:Name="TimeStripCanvas" SizeChanged="TimeStripCanvas_SizeChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Margin="0,1,4,0">
                                <TextBlock Text="events over time" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <Button x:Name="TimeStripResetButton" Content="Full range" FontSize="10"
                                        Padding="6,0" MinHeight="0" Height="18" Visibility="Collapsed"
                                        Click="TimeStripReset_Click"
                                        ToolTipService.ToolTip="Clear the time window (zoom back out to the whole log)"/>
                                <Button Content="✕" FontSize="10" Padding="6,0" MinHeight="0" Height="18"
                                        Click="TimeStripHide_Click" AutomationProperties.Name="Hide time strip"
                                        ToolTipService.ToolTip="Hide the time strip (bring it back from Columns ▾ → Show)"/>
                            </StackPanel>
                        </Grid>
                    </Border>
            <!-- RowHeight + explicit column widths matter a lot for scroll perf:
                 with both unset, DataGrid measures every visible cell on every scroll frame
                 (because Message text length varies). Fixing the row height makes the row
                 virtualizer assume uniform geometry; fixing column widths skips per-cell
                 measure on scroll. RowHeight=28 truncates long Message text in the cell, but
                 the full text is still visible in the row-details panel and the More dialog. -->
            <!--
                Scroll perf: every column is fixed-width (no Star sizing) and explicit
                EnableRow/ColumnVirtualization so the DataGrid never recomputes column
                geometry while inertia-scrolling. The Message column is a fixed 800px instead
                of "*" because Star sizing forces a layout pass each time the scrollbar's
                visibility flips. RowHeight=26 keeps geometry uniform.
                Long Message text is clipped at the cell edge — the row-details panel and
                the "More" dialog still show it in full.
            -->
            <ctWinUI:DataGrid x:Name="ResultsGrid" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              RowHeight="26"
                              HeadersVisibility="All"
                              RowHeaderWidth="22"
                              GridLinesVisibility="None"
                              ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                              LoadingRow="ResultsGrid_LoadingRow"
                              Sorting="ResultsGrid_Sorting"
                              RightTapped="ResultsGrid_RightTapped"
                              DoubleTapped="ResultsGrid_DoubleTapped"
                              SelectionChanged="ResultsGrid_SelectionChanged"
                              RowDetailsTemplate="{StaticResource RowDetailsTemplate}"
                              RowDetailsVisibilityMode="VisibleWhenSelected"
                              SelectionMode="Extended"
                              ClipboardCopyMode="IncludeHeader"
                              AutomationProperties.Name="Search results">
                <ctWinUI:DataGrid.Columns>
                    <ctWinUI:DataGridTextColumn Header="Index"    Binding="{Binding Index}"    Width="70"  ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="Time"     Binding="{Binding LogTime, Converter={StaticResource TimeFmt}}" Width="160" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="120" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="TaskName" Binding="{Binding TaskName}" Width="140" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="Message"  Binding="{Binding Message}"  Width="800" ElementStyle="{StaticResource GridCellTextTip}"/>
                    <ctWinUI:DataGridTextColumn Header="Source"   Binding="{Binding Source, Converter={StaticResource SourceTrim}}" Width="140" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="Level"    Binding="{Binding Level}"    Width="90"  ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="ProcessId"  Binding="{Binding ProcessId}"  Width="80"  ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="ProcessName" Binding="{Binding ProcessName}" Width="140" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="ThreadId"   Binding="{Binding ThreadId}"   Width="80"  ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="ActivityId" Binding="{Binding ActivityId}" Width="240" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="EventId"    Binding="{Binding EventId}"    Width="80"  ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="OpCode"     Binding="{Binding OpCode}"     Width="100" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="Keywords"   Binding="{Binding Keywords}"   Width="140" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="RelatedActivityId" Binding="{Binding RelatedActivityId}" Width="240" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="Channel"    Binding="{Binding Channel}"    Width="120" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="ProviderGuid" Binding="{Binding ProviderGuid}" Width="240" ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="RecordId"   Binding="{Binding RecordId}"   Width="90"  ElementStyle="{StaticResource GridCellText}"/>
                    <ctWinUI:DataGridTextColumn Header="Raw Row"    Binding="{Binding SearchableData}" Width="500" ElementStyle="{StaticResource GridCellText}"/>
                </ctWinUI:DataGrid.Columns>
            </ctWinUI:DataGrid>

            <!-- Loading overlay -->
            <Border x:Name="LoadingOverlay" Grid.Row="1" Visibility="Collapsed"
                    Background="#80000000"
                    AutomationProperties.LiveSetting="Polite">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing Width="48" Height="48" IsActive="True"/>
                    <TextBlock x:Name="LoadingOverlayText" Text="Loading results..." Foreground="White" FontSize="14"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Empty-state overlay: shown when a finished load has zero rows, so the grid never just
                 sits blank. Adapts: "no rows at all" vs "filters hid everything" (offers Clear filters). -->
            <Border x:Name="EmptyOverlay" Grid.Row="1" Visibility="Collapsed"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    AutomationProperties.LiveSetting="Polite">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="440">
                    <FontIcon Glyph="&#xE7BA;" FontSize="32" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="EmptyOverlayTitle" Text="No results" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EmptyOverlayText" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="This search returned no rows."/>
                    <Button x:Name="EmptyOverlayClearFilters" Content="Clear filters" HorizontalAlignment="Center"
                            Margin="0,4,0,0" Visibility="Collapsed" Click="ClearFiltersButton_Click"/>
                    <!-- Shown only in the fresh "nothing loaded yet" state, so the grid isn't a dead end. -->
                    <StackPanel x:Name="EmptyOverlayActions" Orientation="Horizontal" Spacing="8"
                                HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed">
                        <Button Content="Open log file" Click="EmptyOverlayOpenLog_Click" Style="{ThemeResource AccentButtonStyle}"/>
                        <Button Content="Add source" Click="EmptyOverlayAddSource_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>

        <!-- Details panel (Grid.Row=3). The DataGrid's per-row expandable details are disabled
             when this panel is shown — the two ways of viewing details are mutually exclusive.
             Collapsed when DetailsPanelToggle is off (the default "Inrow" mode).
             The Border's Height is set in code-behind from ResultsViewerSettings and updated
             when the user drags the resize grip at the top. The inner grid is Auto/Auto/*, so
             the ScrollViewer takes whatever vertical space remains after the grip + header and
             shows a scrollbar when content overflows it. -->
        <Border x:Name="DetailsPanel" Grid.Row="2" Visibility="Collapsed"
                Height="240"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Resize grip -->
                    <RowDefinition Height="Auto"/>  <!-- Header bar (title + Copy / ✕) -->
                    <RowDefinition Height="*"/>     <!-- Content (fills remaining height) -->
                </Grid.RowDefinitions>

                <!-- Resize grip. Click & drag vertically to change the panel's height. Tracks
                     pointer on the page (not just on the grip element) so the user can drag
                     past the grip's bounds without losing capture. -->
                <Border x:Name="DetailsPanelResizer" Grid.Row="0"
                        Height="8" Background="Transparent"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        PointerEntered="DetailsPanelResizer_PointerEntered"
                        PointerExited="DetailsPanelResizer_PointerExited"
                        PointerPressed="DetailsPanelResizer_PointerPressed"
                        PointerMoved="DetailsPanelResizer_PointerMoved"
                        PointerReleased="DetailsPanelResizer_PointerReleased"
                        PointerCaptureLost="DetailsPanelResizer_PointerCaptureLost"
                        ToolTipService.ToolTip="Drag to resize">
                    <Rectangle Width="48" Height="3"
                               RadiusX="1.5" RadiusY="1.5"
                               Fill="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Grid Grid.Row="1" Padding="12,6"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="Selected row details" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="DetailsFieldsButton" Content="Fields ▾" Click="DetailsFields_Click"
                                Height="28" FontSize="12"
                                ToolTipService.ToolTip="Choose which fields are shown"/>
                        <Button Content="Copy as JSON" Click="DetailsPanelCopyJson_Click"
                                Height="28" FontSize="12"/>
                        <Button Content="Copy as CSV"  Click="DetailsPanelCopyCsv_Click"
                                Height="28" FontSize="12"/>
                        <Button Content="Copy as XML"  Click="DetailsPanelCopyXml_Click"
                                Height="28" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" Padding="12,8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="DetailsPanelGrid" ColumnSpacing="12" RowSpacing="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetailsPanelPlaceholder"
                                   Text="Select a row above to see its full details here."
                                   Grid.ColumnSpan="2"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontStyle="Italic" Margin="0,4,0,4"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Pagination bar: paging on the left; the filtered/total count + filter timing on the right
             (moved down from the toolbar so the toolbar's first-level controls fit at 1280px). -->
        <Border Grid.Row="3" Padding="12,6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="StatusText" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           AutomationProperties.AutomationId="StatusText"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <!-- Filter performance breakdown (what made the last filter/search slow). -->
                <Button x:Name="FilterPerfButton" Height="28" FontSize="12" Padding="8,0,8,0"
                        Content="{x:Bind ViewModel.LastFilterSummary, Mode=OneWay}"
                        ToolTipService.ToolTip="Filter performance breakdown">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="6" MinWidth="300">
                                <TextBlock Text="Filter performance" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.LastFilterBreakdown, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Tip: if the index is still building, text search uses a slower scan until it finishes."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- The four navigation buttons grouped together: « First ‹ Prev  Next › Last » -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="« First" Click="FirstPage_Click" Height="28" FontSize="12"/>
                    <Button Content="‹ Prev"  Click="PrevPage_Click"  Height="28" FontSize="12"/>
                    <Button Content="Next ›"  Click="NextPage_Click"  Height="28" FontSize="12"/>
                    <Button Content="Last »"  Click="LastPage_Click"  Height="28" FontSize="12"/>
                </StackPanel>
                <TextBlock x:Name="PagerStatus" AutomationProperties.AutomationId="PagerStatus"
                           VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0">
                    <Run Text="Page "/>
                    <Run Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}"/>
                    <Run Text=" of "/>
                    <Run Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}"/>
                    <Run Text="  ·  "/>
                    <Run Text="{x:Bind ViewModel.PageRangeText, Mode=OneWay}"/>
                    <Run Text=" of "/>
                    <Run Text="{x:Bind ViewModel.TotalFilteredCountText, Mode=OneWay}"/>
                </TextBlock>
                <TextBox x:Name="PageJumpBox" Width="60" Height="28" FontSize="12"
                         PlaceholderText="# go to" KeyDown="PageJumpBox_KeyDown"
                         AutomationProperties.Name="Jump to page"/>
                <Button Content="Go" Click="PageJump_Click" Height="28" FontSize="12"/>
                <TextBlock Text="Page size:" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16,0,0,0"/>
                <ComboBox x:Name="PageSizeCombo" Width="80" Height="28" FontSize="12"
                          SelectionChanged="PageSizeCombo_SelectionChanged"
                          AutomationProperties.Name="Page size">
                    <ComboBoxItem Content="50"   Tag="50"/>
                    <ComboBoxItem Content="100"  Tag="100"/>
                    <ComboBoxItem Content="250"  Tag="250"/>
                    <ComboBoxItem Content="500"  Tag="500"/>
                    <ComboBoxItem Content="1000" Tag="1000"/>
                    <ComboBoxItem Content="5000" Tag="5000"/>
                </ComboBox>
            </StackPanel>
          </Grid>
        </Border>
            </Grid>   <!-- main content column -->
        </Grid>       <!-- BodyGrid -->
    </Grid>
</Page>
