<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FindNeedleUX.Pages.PerformanceBenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FindNeedleUX.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel MaxWidth="820" Spacing="14">
            <TextBlock Text="Performance benchmark" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Runs FindNeedle's search engine on synthetic logs generated on THIS machine and reports how it performs — no admin, no external data. The result file contains only hardware specs and timings (no log data), so it's safe to share. Ratios like FTS-vs-scan compare across machines; milliseconds are specific to your hardware and current load."/>

            <!-- Machine -->
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="This machine" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MachineText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Run -->
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="16">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Workload" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PresetCombo" SelectedIndex="0" Width="360">
                            <ComboBoxItem Content="Quick — 100k + 1M rows (~30 s)"/>
                            <ComboBoxItem Content="Full — up to 5M rows (~1–2 min, ~350 MB temp)"/>
                            <ComboBoxItem Content="Stress — up to 10M rows (~several min, ~700 MB temp)"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Uses significant CPU and disk while running; temp files are deleted afterward. Close other apps for cleaner numbers — the report records the CPU already in use so busy-machine runs are interpretable."/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RunButton" Content="Run benchmark" Click="Run_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button x:Name="ProfileButton" Content="Profile workload" Click="Profile_Click"
                                ToolTipService.ToolTip="Separate run that CPU-samples a 1M-line load+search to show WHICH code paths take the longest. Slower (sampling perturbs timing), so it doesn't affect the benchmark numbers."/>
                        <ProgressRing x:Name="Progress" IsActive="False" Width="20" Height="20"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Results -->
            <Border x:Name="ResultsCard" Visibility="Collapsed"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Results" FontWeight="SemiBold"/>
                    <StackPanel x:Name="ResultsHost" Spacing="6"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Content="Open HTML report" Click="OpenHtml_Click" Style="{StaticResource AccentButtonStyle}"/>
                        <Button Content="Show JSON to submit" Click="ShowJson_Click"
                                ToolTipService.ToolTip="Opens the result file in Explorer — attach it to the Benchmark submissions discussion"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="The JSON has hardware + timings only — safe to share."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
