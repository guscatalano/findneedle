<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FindNeedleUX.Pages.DiagramToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FindNeedleUX.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock x:Name="PageHeading" Text="Diagram tools" Style="{StaticResource PageHeading}" Margin="0,0,0,4"/>
            <TextBlock Text="Manage UML diagram generation tools for visualizing log sequences."
                       Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"/>


            <!-- Install Progress (at top) -->
            <Border x:Name="InstallProgressPanel" Visibility="Collapsed" Style="{StaticResource PageCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="InstallProgressText" Text="Installing..." Margin="0,0,0,10"
                               IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar x:Name="InstallProgressBar" IsIndeterminate="True"
                                 AutomationProperties.Name="Installation progress"
                                 AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <!-- Timeline Demo Section -->
            <TextBlock Text="Desktop Session Replay" Style="{StaticResource CardTitle}" Margin="0,8,0,4"/>
            <TextBlock Text="Interactive demo that replays window movement across multiple monitors. You can open it in-app or in your external browser."
                       Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource PageCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▤" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Text="Timeline demo viewer" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Open (In-App)" Click="OpenDemoInApp_Click"/>
                        <Button Content="Open (External)" Click="OpenDemoExternal_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PlantUML Section -->
            <TextBlock Text="PlantUML" Style="{StaticResource CardTitle}" Margin="0,8,0,4"/>
            <TextBlock Text="Generates UML diagrams using Java. Best for detailed sequence diagrams with notes and groups."
                       Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>

            <Border Style="{StaticResource PageCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                        <TextBlock x:Name="PlantUmlStatusIcon" Text="?" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="PlantUmlStatusText" Text="Checking..." FontSize="14" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>

                    <TextBlock x:Name="PlantUmlPathDisplay" Grid.Row="1" Grid.Column="0"
                               Text="" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis" Margin="26,5,0,0"/>

                    <TextBlock x:Name="PlantUmlVersionDisplay" Grid.Row="2" Grid.Column="0"
                               Text="" Opacity="0.5" FontSize="11" Margin="26,2,0,0"/>

                    <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="TestPlantUmlButton" Content="Test" Click="TestPlantUml_Click" MinWidth="60"
                                AutomationProperties.Name="Test PlantUML installation"/>
                        <Button x:Name="InstallPlantUmlButton" Content="Install" Click="InstallPlantUml_Click" MinWidth="80"
                                AutomationProperties.Name="Install PlantUML"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Custom PlantUML JAR path (moved here from System Check) -->
            <Border Style="{StaticResource PageCard}" Margin="0,0,0,20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Custom PlantUML JAR path" FontWeight="SemiBold"/>
                    <TextBlock Text="Point at a specific plantuml.jar to override the bundled/installed copy. Leave unset to use the install above."
                               Style="{StaticResource SecondaryText}"/>
                    <!-- Path fills the row; the button sits at the card's right edge, in line with the
                         Test / Reinstall buttons of the cards above and below (a fixed 460px path left it
                         stranded mid-card). -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="PlantUmlCustomPathText" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Grid.Column="1" Content="Change…" Click="ChangePlantUmlPath_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Mermaid Section -->
            <TextBlock Text="Mermaid CLI" Style="{StaticResource CardTitle}" Margin="0,8,0,4"/>
            <TextBlock Text="Generates diagrams using Node.js. Great for web-friendly output and simpler diagrams."
                       Style="{StaticResource SecondaryText}" Margin="0,0,0,8"/>

            <Border Style="{StaticResource PageCard}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
                        <TextBlock x:Name="MermaidStatusIcon" Text="?" Margin="0,0,10,0" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock x:Name="MermaidStatusText" Text="Checking..." FontSize="14" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>

                    <TextBlock x:Name="MermaidPathDisplay" Grid.Row="1" Grid.Column="0"
                               Text="" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis" Margin="26,5,0,0"/>

                    <TextBlock x:Name="MermaidVersionDisplay" Grid.Row="2" Grid.Column="0"
                               Text="" Opacity="0.5" FontSize="11" Margin="26,2,0,0"/>

                    <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="TestMermaidButton" Content="Test" Click="TestMermaid_Click" MinWidth="60"
                                AutomationProperties.Name="Test Mermaid CLI installation"/>
                        <Button x:Name="InstallMermaidButton" Content="Install" Click="InstallMermaid_Click" MinWidth="80"
                                AutomationProperties.Name="Install Mermaid CLI"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Test Options -->
            <TextBlock Text="Test options" Style="{StaticResource CardTitle}" Margin="0,8,0,4"/>
            <Border Style="{StaticResource PageCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Preferred output format" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Spacing="20">
                        <RadioButton x:Name="OutputPngRadio" Content="PNG Image" GroupName="OutputFormat"
                                     IsChecked="True" Checked="OutputFormat_Changed"/>
                        <RadioButton x:Name="OutputBrowserRadio" Content="Browser (HTML)" GroupName="OutputFormat"
                                     Checked="OutputFormat_Changed"/>
                    </StackPanel>
                    <TextBlock Text="PNG generates a static image file. Browser generates an interactive HTML file."
                               Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Install Directory Info -->
            <TextBlock Text="Installation directory" Style="{StaticResource CardTitle}" Margin="0,8,0,4"/>
            <TextBlock x:Name="InstallDirectoryText" Text="" Style="{StaticResource SecondaryText}" FontFamily="Consolas"
                       IsTextSelectionEnabled="True"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="10">
                <Button Content="Open Install Folder" Click="OpenInstallFolder_Click"/>
                <Button Content="Open Test Output Folder" Click="OpenTestOutputFolder_Click"/>
                <Button Content="Open Command Prompt" Click="OpenCommandPrompt_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
