<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FindNeedleUX.Pages.RunSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FindNeedleUX.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageHeading" Text="Run search" Style="{StaticResource PageHeading}"/>
                <TextBlock Text="Execute your search pipeline and view results" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>

            <!-- Zero-source guard: shown instead of running over nothing. -->
            <InfoBar x:Name="NoSourcesBar" Severity="Warning" IsOpen="False" IsClosable="True"
                     Title="No sources to search"
                     Message="Add at least one source (a folder, file, or live log) before running.">
                <InfoBar.ActionButton>
                    <Button Content="Add source" Click="AddSource_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- The "Search depth" Full/Quick radio group used to sit here. Removed because it did nothing:
                 the value reached ISearchLocation.SetSearchDepth and NOTHING ever read it back
                 (GetSearchDepth has no callers anywhere), so "Quick - headers / first lines only (faster)"
                 ran the same full scan at the same cost. Better no control than one that lies. The lever
                 that really does cut the work is the decode-time scope (provider / time / level) offered
                 by large-file triage. -->

            <Border Style="{StaticResource PageCard}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Actions" Style="{StaticResource CardTitle}"/>
                    <!-- Same 36px accent Run button as the Home page — the 48px/16pt pair here was the
                         only oversized control in the app. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RunButton" Content="Run search" Click="Button_Click" Height="36" Padding="16,0"
                                Style="{ThemeResource AccentButtonStyle}"
                                AutomationProperties.Name="Run search"/>
                        <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Height="36" Padding="16,0"
                                IsEnabled="False"
                                AutomationProperties.Name="Cancel search"/>
                    </StackPanel>

                    <ProgressBar x:Name="busybar" MaxWidth="480" HorizontalAlignment="Left" IsIndeterminate="True" ShowPaused="True" ShowError="False" Margin="0,8,0,0"
                                 AutomationProperties.Name="Search progress (indeterminate)"
                                 AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar x:Name="busybar2" MaxWidth="480" HorizontalAlignment="Left" IsIndeterminate="False" ShowPaused="True" ShowError="False"
                                 AutomationProperties.Name="Search progress"
                                 AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="progresstext" Style="{StaticResource SecondaryText}" FontSize="13"
                               AutomationProperties.LiveSetting="Polite"/>

                    <Border BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4" Padding="12" Margin="0,8,0,0"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Search summary" FontWeight="SemiBold"/>
                            <TextBlock x:Name="summary" Style="{StaticResource SecondaryText}" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
