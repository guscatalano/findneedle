<Page
    x:Class="FindNeedleUX.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FindNeedleUX.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Home: one open model. Left = get a log in front of you (open / recent / known); right = the
         workspace it lands in (sources, rule files, run) plus the Add / Replace / Ask policy. The
         customizable Shortcuts tiles sit below because the primary actions now live in the cards. -->
    <Page.Resources>
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="HyperlinkButton">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="Root">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Layout">
                <!-- Narrow: the workspace column drops under the open column. -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightColumn.(Grid.Column)" Value="0"/>
                        <Setter Target="RightColumn.(Grid.Row)" Value="1"/>
                        <Setter Target="RightColumnDef.Width" Value="0"/>
                        <Setter Target="Columns.ColumnSpacing" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000"/></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RightColumn.(Grid.Column)" Value="1"/>
                        <Setter Target="RightColumn.(Grid.Row)" Value="0"/>
                        <Setter Target="RightColumnDef.Width" Value="420"/>
                        <Setter Target="Columns.ColumnSpacing" Value="24"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Padding="32,24,32,24" Spacing="20" MaxWidth="1440" HorizontalAlignment="Stretch">

            <Grid x:Name="Columns" ColumnSpacing="24" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="RightColumnDef" Width="420"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===================== Left: open a log ===================== -->
                <StackPanel x:Name="LeftColumn" Grid.Column="0" Grid.Row="0" Spacing="20" MinWidth="0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Open a log" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Secondary}" FontSize="13"
                                   Text="Opening a log adds it to your workspace and runs the search. Sources, rule files and results stay together."/>
                    </StackPanel>

                    <Border Style="{StaticResource HomeCard}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="OpenFileButton" Content="Open log file…" Click="OpenFile_Click"
                                        Style="{StaticResource AccentButtonStyle}" Height="36" Padding="18,0" FontSize="14"
                                        ToolTipService.ToolTip="Pick a log file (Ctrl+O)"/>
                                <Button Grid.Column="1" x:Name="OpenFolderButton" Content="Open folder…" Click="OpenFolder_Click"
                                        Height="36" Padding="16,0" FontSize="14"
                                        ToolTipService.ToolTip="Pick a folder — every log inside it becomes one source"/>
                                <Button Grid.Column="2" x:Name="OpenWithRulesButton" Content="Open with rules…" Click="OpenWithRules_Click"
                                        Height="36" Padding="16,0" FontSize="14"
                                        ToolTipService.ToolTip="Pick a log file, then a rule file, and open the results"/>
                                <TextBlock Grid.Column="4" Text="Ctrl+O" Style="{StaticResource Secondary}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                            <!-- Drop zone: the whole window already accepts drops (MainWindow Content_Drop); this
                                 is the visible invitation. Dashed border via a Rectangle (Border can't dash). -->
                            <Grid Height="56" AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                                <Rectangle Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"
                                           StrokeDashArray="4,3" RadiusX="4" RadiusY="4"
                                           Fill="{ThemeResource SubtleFillColorTransparentBrush}"/>
                                <TextBlock Style="{StaticResource Secondary}" HorizontalAlignment="Center"
                                           Text="or drop .etl, .evtx, .log, .zip or a folder anywhere in this window"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Recent searches (the 3 newest cached results) -->
                    <Border Style="{StaticResource HomeCard}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Recent searches" Style="{StaticResource CardTitle}"/>
                                <TextBlock Grid.Column="1" Text="reopen instantly" Style="{StaticResource Secondary}" FontSize="13"/>
                                <HyperlinkButton Grid.Column="2" Content="See all" Click="SeeAllRecent_Click" Style="{StaticResource LinkButton}"
                                                 AutomationProperties.Name="See all recent searches"/>
                            </Grid>
                            <StackPanel x:Name="RecentHost" Spacing="0"/>
                            <TextBlock x:Name="RecentEmpty" Style="{StaticResource Secondary}" Visibility="Collapsed"
                                       Text="No recent searches yet. Open a log and it will show up here."/>
                        </StackPanel>
                    </Border>

                    <!-- Known logs (3 from the Known logs catalog) -->
                    <Border Style="{StaticResource HomeCard}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Known logs" Style="{StaticResource CardTitle}"/>
                                <TextBlock Grid.Column="1" Text="common Windows locations" Style="{StaticResource Secondary}" FontSize="13"/>
                                <HyperlinkButton Grid.Column="2" Content="See all" Click="SeeAllKnown_Click" Style="{StaticResource LinkButton}"
                                                 AutomationProperties.Name="See all known logs"/>
                            </Grid>
                            <StackPanel x:Name="KnownLogsHost" Spacing="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Right: the current workspace ===================== -->
                <StackPanel x:Name="RightColumn" Grid.Column="1" Grid.Row="0" Spacing="16" MinWidth="0">
                    <Border Style="{StaticResource HomeCard}">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Current workspace" Style="{StaticResource CardTitle}"/>
                                <TextBlock Grid.Column="1" x:Name="WorkspaceNameText" Style="{StaticResource Secondary}"
                                           FontFamily="Consolas" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </Grid>

                            <!-- Empty state (shown instead of the lists when nothing is loaded) -->
                            <TextBlock x:Name="WorkspaceEmpty" Style="{StaticResource Secondary}" FontSize="13"
                                       Text="Nothing loaded yet — open a log to start."/>

                            <StackPanel x:Name="WorkspaceBody" Spacing="14">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sources" Style="{StaticResource Secondary}"/>
                                        <TextBlock Grid.Column="1" x:Name="SourcesCount" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <HyperlinkButton Grid.Column="3" Content="Add source" Click="AddSource_Click" Style="{StaticResource LinkButton}"/>
                                    </Grid>
                                    <StackPanel x:Name="SourcesHost" Spacing="6"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Rule files" Style="{StaticResource Secondary}"/>
                                        <TextBlock Grid.Column="1" x:Name="RulesCount" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <HyperlinkButton Grid.Column="3" Content="Edit rules" Click="EditRules_Click" Style="{StaticResource LinkButton}"/>
                                    </Grid>
                                    <StackPanel x:Name="RulesHost" Spacing="6"/>
                                    <TextBlock x:Name="RulesEmpty" Style="{StaticResource Secondary}" Text="No rule files — results are unfiltered."/>
                                </StackPanel>

                                <Grid ColumnSpacing="10" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="RunSearchButton" Click="RunSearch_Click"
                                            Style="{StaticResource AccentButtonStyle}" Height="36" Padding="16,0"
                                            ToolTipService.ToolTip="Run the search over every source with the loaded rule files">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="12"/>
                                            <TextBlock Text="Run search"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" x:Name="OpenResultsButton" Content="Open results" Click="OpenResults_Click" Height="36"
                                            ToolTipService.ToolTip="Open the results of the last run"/>
                                    <TextBlock Grid.Column="2" x:Name="LastRunText" Style="{StaticResource Secondary}"
                                               HorizontalAlignment="Right" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Open policy: Add / Replace / Ask. Bound to ResultsViewerSettings.OpenIntoWorkspace;
                         the same card lives in Settings and both follow the settings Changed event. -->
                    <Border Style="{StaticResource HomeCard}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="When you open another log while this workspace is loaded" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <RadioButtons x:Name="PolicyRadios" SelectionChanged="PolicyRadios_SelectionChanged"
                                          AutomationProperties.Name="When you open another log while this workspace is loaded">
                                <RadioButton Tag="Add" MinHeight="32" AutomationProperties.Name="Add it to this workspace (default)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Add it to this workspace"/>
                                        <TextBlock Text="default" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Tag="Replace" Content="Replace the workspace" MinHeight="32"/>
                                <RadioButton Tag="Ask" Content="Ask each time" MinHeight="32"/>
                            </RadioButtons>
                            <TextBlock Style="{StaticResource Secondary}" Text="Your sources and rule files are never discarded without asking."/>
                        </StackPanel>
                    </Border>

                    <!-- Workspaces: the same actions as the Open menu -->
                    <Border Style="{StaticResource HomeCard}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Workspaces" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="New" Click="NewWorkspace_Click" ToolTipService.ToolTip="Stop any running search and start over with an empty workspace"/>
                                <Button Content="Open…" Click="OpenWorkspace_Click" ToolTipService.ToolTip="Open a saved workspace (.json)"/>
                                <Button Content="Save" Click="SaveWorkspace_Click" ToolTipService.ToolTip="Save the sources and rule files as a workspace (Ctrl+S)"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Shortcuts: the customizable tiles (QuickActionCatalog). Compact, below the cards. -->
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Shortcuts" Style="{StaticResource CardTitle}"/>
                    <Button Grid.Column="1" x:Name="CustomizeButton" Click="Customize_Click"
                            Background="Transparent" BorderThickness="0" Padding="8,4"
                            AutomationProperties.Name="Customize shortcuts">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon x:Name="CustomizeIcon" Symbol="Edit"/>
                            <TextBlock x:Name="CustomizeLabel" Text="Customize…"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <local:SimpleWrapPanel x:Name="QuickActionsHost" HorizontalSpacing="8" VerticalSpacing="8"/>
            </StackPanel>

            <HyperlinkButton Content="View documentation" NavigateUri="https://github.com/guscatalano/findneedle"
                             Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Page>
