    <ProjectReference Include="..\FindPluginCore\FindPluginCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Assets\appicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Update="Pages\DiagramToolsPage.xaml">
