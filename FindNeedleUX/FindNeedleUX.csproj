<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FindNeedleUX</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- We supply our own entry point (Program.cs) to do single-instance activation redirection
         (so "Open with" of a 2nd file reuses the running window instead of spawning a new one).
         The generated Main in App.g.i.cs is gated by the DISABLE_XAML_GENERATED_MAIN compile constant;
         this SDK doesn't auto-define it from <DisableXamlGeneratedMain>, so define it explicitly. -->
    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseRidGraph>true</UseRidGraph>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
    <AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>True</GenerateTestArtifacts>
    <AppxBundle>Never</AppxBundle>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
     <SelfContained>true</SelfContained>
	  <NuGetAudit>false</NuGetAudit>
	  <Nullable>enable</Nullable>
	  <NoWarn>$(NoWarn);CS8618;CS8603;CS8601;CS8602;CS8600;CS8604;CS8612;CS8625;CS8765;CS8769;CS0105;IDE0007;IDE0059;IDE0044;WinUIEx1001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AppxPackageSigningEnabled)' != 'false'">
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
    <PackageCertificateThumbprint>735D3C00542E608B9F30374C33E3BFD5846B15D1</PackageCertificateThumbprint>
  </PropertyGroup>

  <PropertyGroup>
    <WindowsAppSDKWinUI>true</WindowsAppSDKWinUI>
    <ApplicationIcon>Square44x44Logo.scale-200.ico</ApplicationIcon>
    <Title>Find Needle</Title>
    <Authors>Gus Catalano</Authors>
    <Version>0.0.1</Version>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms> <!-- Workaround for https://github.com/unoplatform/uno/discussions/13569 -->				
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\appicon.ico" />
