<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FindNeedleUX.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FindNeedleUX"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local1="using:FindNeedleUX.ViewObjects"
    mc:Ignorable="d"
    Title="FindNeedle">

    <Grid x:Name="RootGrid">
        <!-- The Ctrl+K (command palette) accelerator is added in CODE, and ONLY while the palette is enabled
             (see ApplyCommandPaletteAccelerator). Declaring it here unconditionally left WinUI rendering a
             "Ctrl+K" shortcut hint even when the palette was off — a shortcut that did nothing. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Back navigates the contentFrame's history (disabled when there's nowhere to go back to). -->
            <Button x:Name="BackButton" Grid.Column="0" Click="BackButton_Click" IsEnabled="False"
                    Background="Transparent" BorderThickness="0" VerticalAlignment="Stretch" Padding="12,0"
                    ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Left"/>
                </Button.KeyboardAccelerators>
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
            </Button>
        <!-- Menu titles double as the breadcrumb sections (see Services/PageCatalog): Open ▸ Workspace ▸ Run ▸
             Tools ▸ Diagnostics ▸ Help. Item Names are stable ids (persisted settings, automation, tests) —
             change labels and grouping here, never the Name. Page-backed labels are re-applied from
             PageCatalog in code so the menu, breadcrumb, and page heading can't drift apart. -->
        <MenuBar Grid.Column="1" x:Name="MainMenuBar">
            <!-- Open: get a log in front of you (replaces the code-built "Quick" menu; the welcome tiles remain). -->
            <MenuBarItem x:Name="OpenMenu" Title="Open">
                <MenuFlyoutItem Text="Open log file…" Click="MenuFlyoutItem_Click" Name="openlogfile">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator x:Name="OpenFileAccelerator" Modifiers="Control" Key="O"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open folder…" Click="MenuFlyoutItem_Click" Name="openlogfolder"/>
                <MenuFlyoutItem Text="Open with rules…" Click="MenuFlyoutItem_Click" Name="openlogwithrules"
                                ToolTipService.ToolTip="Pick a log file and a rules file, then open the results"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Recent searches" Click="MenuFlyoutItem_Click" Name="cached_searches"
                                ToolTipService.ToolTip="Logs you've opened before — reopen them without re-scanning"/>
                <MenuFlyoutItem Text="Known logs" Click="MenuFlyoutItem_Click" Name="log_finder"
                                ToolTipService.ToolTip="A catalog of well-known Windows logs you can open directly"/>
                <MenuFlyoutSeparator/>
                <!-- New workspace = the old Clear (stops a running search, drops results/rules) + a fresh query. -->
                <MenuFlyoutItem Text="New workspace" Click="MenuFlyoutItem_Click" Name="NewWorkspace"
                                ToolTipService.ToolTip="Stop any running search and start over with an empty workspace"/>
                <MenuFlyoutItem Text="Open workspace…" Click="MenuFlyoutItem_Click" Name="OpenWorkspace"/>
                <MenuFlyoutItem Text="Save workspace" Click="MenuFlyoutItem_Click" Name="SaveWorkspace">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator x:Name="SaveWorkspaceAccelerator" Modifiers="Control" Key="S"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <!-- Workspace: what the search is made of (was "Configure"). -->
            <MenuBarItem x:Name="WorkspaceMenu" Title="Workspace">
                <MenuFlyoutItem Text="Sources" Click="MenuFlyoutItem_Click" Name="search_location"/>
                <MenuFlyoutItem Text="Rule files" Click="MenuFlyoutItem_Click" Name="rules"/>
                <MenuFlyoutItem Text="Auto rules" Click="MenuFlyoutItem_Click" Name="auto_rules"/>
                <MenuFlyoutItem Text="Field extraction" Click="MenuFlyoutItem_Click" Name="reformat_rules"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Connections" Click="MenuFlyoutItem_Click" Name="connections"/>
            </MenuBarItem>

            <!-- Run: run it, then look at what came out. -->
            <MenuBarItem x:Name="RunMenu" Title="Run">
                <MenuFlyoutItem Text="Run search" Click="MenuFlyoutItem_Click" Name="results_get"
                                ToolTipService.ToolTip="Run the search over your sources and rule files, then open the results">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator x:Name="RunSearchAccelerator" Key="F5"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <!-- Esc is registered in code, only while a search is running (see ApplyStopAccelerator) — a
                     permanent Escape accelerator would swallow the key everywhere. The hint is shown regardless. -->
                <MenuFlyoutItem Text="Stop" Click="MenuFlyoutItem_Click" Name="stop_search" IsEnabled="False"
                                KeyboardAcceleratorTextOverride="Esc"
                                ToolTipService.ToolTip="Cancel the running search"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Open results" Click="MenuFlyoutItem_Click" Name="results_viewnative"
                                ToolTipService.ToolTip="Open the results of the last run without re-running"/>
                <MenuFlyoutItem Text="Outputs" Click="MenuFlyoutItem_Click" Name="results_processoroutput"
                                ToolTipService.ToolTip="Files and diagrams the rule files produced"/>
                <MenuFlyoutItem Text="Search timing" Click="MenuFlyoutItem_Click" Name="results_statistics"
                                ToolTipService.ToolTip="Where the time went in the last run (why so slow?)"/>
                <MenuFlyoutSeparator x:Name="RemapCsvSeparator" Visibility="Collapsed"/>
                <MenuFlyoutItem x:Name="RemapCsvMenuItem" Text="Remap CSV columns…" Click="RemapCsvMenuItem_Click" Visibility="Collapsed"/>
            </MenuBarItem>

            <MenuBarItem x:Name="ToolsMenu" Title="Tools">
                <MenuFlyoutItem Text="Inspect ETL" Click="MenuFlyoutItem_Click" Name="inspect_etl"/>
                <MenuFlyoutItem Text="Inspect binary" Click="MenuFlyoutItem_Click" Name="inspect_binary"/>
                <MenuFlyoutItem Text="Symbols (WPP)…" Click="MenuFlyoutItem_Click" Name="wpp_symbols"
                                ToolTipService.ToolTip="Resolve the PDBs/TMFs a WPP .etl needs to decode — point at your symbols and see per-binary status"/>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem Text="Diagram tools" Click="MenuFlyoutItem_Click" Name="diagramtools"/>
                <MenuFlyoutItem Text="Plugins" Click="MenuFlyoutItem_Click" Name="search_plugins"/>
            </MenuBarItem>

            <!-- Diagnostics: the app looking at itself. -->
            <MenuBarItem x:Name="DiagnosticsMenu" Title="Diagnostics">
                <MenuFlyoutItem Text="System check" Click="MenuFlyoutItem_Click" Name="systeminfo"/>
                <MenuFlyoutItem Text="App log" Click="MenuFlyoutItem_Click" Name="logs"
                                ToolTipService.ToolTip="FindNeedle's own diagnostic log — not the logs you're analyzing"/>
                <MenuFlyoutItem Text="Performance benchmark…" Click="MenuFlyoutItem_Click" Name="perf_benchmark"
                                ToolTipService.ToolTip="Measure how this machine performs on a standard synthetic workload — share the result to compare hardware"/>
                <!-- Developer-only (hidden unless AppMode.IsDeveloper). -->
                <MenuFlyoutSeparator x:Name="PreviewDevSeparator"/>
                <MenuFlyoutItem Text="Preview first-run (new user)…" Click="MenuFlyoutItem_Click" Name="preview_new_user"
                                ToolTipService.ToolTip="Launch a second instance with an empty, throwaway profile — see the app as a brand-new user would. Your real settings/caches are untouched."/>
                <MenuFlyoutItem Text="Simulate: 1000 WPP providers (75% missing)" Click="MenuFlyoutItem_Click" Name="sim_wpp_scale"
                                ToolTipService.ToolTip="Open the WPP symbol-resolution page filled with a synthetic large, mostly-unresolved trace — a scale check for the resolution UI."/>
            </MenuBarItem>

            <MenuBarItem x:Name="HelpMenu" Title="Help">
                <MenuFlyoutItem Text="Viewer help" Click="MenuFlyoutItem_Click" Name="viewer_help"
                                ToolTipService.ToolTip="Filtering, query syntax and navigation in the results viewer (Documentation when the viewer isn't open)">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator x:Name="ViewerHelpAccelerator" Key="F1"/>
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Documentation" Click="MenuFlyoutItem_Click" Name="documentation"/>
                <MenuFlyoutItem Text="About" Click="MenuFlyoutItem_Click" Name="about"/>
            </MenuBarItem>
        </MenuBar>
        </Grid>

        <!-- Top-right: in-app MCP server toggle + config/help popout -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
            <ToggleButton x:Name="McpToggle" Click="McpToggle_Click" Padding="8,2" MinHeight="28"
                          ToolTipService.ToolTip="In-app MCP server — lets an AI agent read &amp; drive the result viewer">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="McpStatusDot" Width="9" Height="9" Fill="Gray"/>
                    <TextBlock Text="AI agent (MCP)" FontSize="13"/>
                </StackPanel>
            </ToggleButton>
            <Button x:Name="McpHelpButton" Click="McpHelpButton_Click" Padding="6,2" MinHeight="28"
                    ToolTipService.ToolTip="MCP server configuration &amp; how to connect">
                <FontIcon Glyph="&#xE946;" FontSize="14"/>
            </Button>
            <Button x:Name="SettingsButton" Click="SettingsButton_Click" Padding="8,2" MinHeight="28"
                    ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="14"/>
                    <TextBlock Text="Settings" FontSize="13"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- "You are here": <menu section> ▸ <page title>, driven from contentFrame.Navigated via
             PageCatalog, plus a compact workspace chip on the right (same numbers as the window caption). -->
        <Border x:Name="BreadcrumbBar" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="0,1,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Padding="16,0"
                MinHeight="36" AutomationProperties.Name="Current page">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="BreadcrumbSection" FontSize="13" VerticalAlignment="Center" AutomationProperties.AutomationId="BreadcrumbSection"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <FontIcon x:Name="BreadcrumbChevron" Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="BreadcrumbTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="BreadcrumbTitle"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Command-palette hint (Ctrl+K). Visible only while the palette is enabled (ApplyHotkeys). -->
                    <Button x:Name="PaletteHintButton" Click="PaletteHintButton_Click" Background="Transparent"
                            BorderThickness="0" Padding="8,2" MinHeight="24" Margin="0,0,8,0"
                            ToolTipService.ToolTip="Command palette — jump to any page or action (Ctrl+K)"
                            AutomationProperties.Name="Command palette (Ctrl+K)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Ctrl+K" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Workspace" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Border x:Name="WorkspaceChip" CornerRadius="12" BorderThickness="1" Padding="10,2" MinHeight="24"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            ToolTipService.ToolTip="The current workspace — click to see its sources"
                            AutomationProperties.Name="Workspace">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="WorkspaceChipName" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WorkspaceChipSummary" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status strip (bottom of the window): clickable, iconed segments + a hide button. -->
        <Border x:Name="StatusStripBorder" Grid.Row="3" Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource SystemControlForegroundAltHighBrush}" Padding="8,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="StatusSegments" Grid.Column="0" Orientation="Horizontal"
                            Spacing="2" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="StatusEditButton" Click="EditStatusBar_Click"
                            Background="Transparent" BorderThickness="0" Padding="6,2" MinHeight="0"
                            ToolTipService.ToolTip="Choose what shows here">
                        <FontIcon Glyph="&#xE70F;" FontSize="11"/>
                    </Button>
                    <Button x:Name="StatusHideButton" Click="HideStatusStrip_Click"
                            Background="Transparent" BorderThickness="0" Padding="6,2" MinHeight="0"
                            ToolTipService.ToolTip="Hide status bar">
                        <FontIcon Glyph="&#xE711;" FontSize="11"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content area with overlay spinner. AllowDrop here lets you drag log files/folders
             onto the viewer to open them (events bubble up from the hosted page in contentFrame). -->
        <Grid Grid.Row="2" AllowDrop="True"
              DragOver="Content_DragOver" DragLeave="Content_DragLeave" Drop="Content_Drop">
            <!-- Notices get their OWN row so they push the page down instead of painting over it. They
                 used to share the cell with contentFrame (VerticalAlignment=Top + ZIndex), which meant the
                 cache prompt landed straight on top of the Home page's heading — two bits of text in the
                 same pixels. A closed InfoBar collapses, so the row costs nothing when there is no notice. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!-- Dismissible "your cached searches are large" prompt (see App startup + ShowCacheCleanupPrompt).
                     An InfoBar, NOT a dialog, so it never blocks launch or hits ContentDialog re-entrancy. -->
                <InfoBar x:Name="CacheCleanupBar" Margin="12,12,12,0"
                         IsOpen="False" IsClosable="True" Severity="Informational"
                         Title="Cached searches are large" Closed="CacheCleanupBar_Closed">
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,8">
                            <Button Content="Clean up now" Click="CacheCleanupNow_Click"/>
                            <Button Content="Always clean up at launch" Click="CacheCleanupAlways_Click"/>
                            <Button Content="Never ask" Click="CacheCleanupNever_Click"/>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <!-- "Search failed" notice. An InfoBar, NOT a dialog: a second ContentDialog.ShowAsync while
                     one is open is a native failfast, and a failing run is exactly when another dialog
                     (triage, cache reuse, open policy) may already be up. -->
                <InfoBar x:Name="RunFailedBar" Margin="12,12,12,0"
                         IsOpen="False" IsClosable="True" Severity="Error"
                         Title="Search failed"/>
            </StackPanel>

            <Frame x:Name="contentFrame" Grid.Row="1" />
            <!-- Full-window overlay spinner for ETL inspection and quick actions -->
            <Grid x:Name="SpinnerPanel" Visibility="Collapsed" Grid.RowSpan="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Operation in progress" AutomationProperties.LiveSetting="Polite">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                    <ProgressRing x:Name="EtlSpinner" Width="64" Height="64" IsActive="False" AutomationProperties.Name="Working"/>
                    <ProgressBar x:Name="SpinnerBar" Width="320" IsIndeterminate="False" Visibility="Collapsed"
                                 AutomationProperties.Name="Working"/>
                    <!-- Animated robot loader (alternative to the spinner; chosen in settings). The
                         frame shown tracks the current search step. Box scales both square + wide art.
                         Wrapped in a framed card so it reads as an immersive panel. -->
                    <Border x:Name="SpinnerGifBorder" Visibility="Collapsed"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="16" Translation="0,0,32">
                        <Border.Shadow>
                            <ThemeShadow/>
                        </Border.Shadow>
                        <Image x:Name="SpinnerGif" MaxWidth="360" MaxHeight="240" Stretch="Uniform"
                               AutomationProperties.Name="Working"/>
                    </Border>

                    <!-- Structured step checklist (search→view flow). Fixed columns so the name,
                         metric, and percent line up across every step. -->
                    <ItemsControl x:Name="StepList" Margin="0,16,0,0" Visibility="Collapsed" MinWidth="480">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2" Opacity="{Binding Opacity}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14"
                                               FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextAlignment="Right" Margin="8,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="SpinnerText" Text="Inspecting file..." Margin="0,16,0,0" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center"/>
                    <Button x:Name="CancelQuickActionButton" Content="Cancel" Width="100" Margin="0,24,0,0" Click="CancelQuickActionButton_Click" Visibility="Collapsed"
                            AutomationProperties.Name="Cancel current operation"/>
                </StackPanel>
            </Grid>

            <!-- Drag-and-drop overlay: shown while files are dragged over the viewer (hit-test off so
                 the drag events still reach the grid below). -->
            <Border x:Name="DropOverlay" Visibility="Collapsed" Grid.RowSpan="2" IsHitTestVisible="False" Margin="8"
                    Background="#CC101418" CornerRadius="6"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="3">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon Glyph="&#xE896;" FontSize="44" Foreground="White"/>
                    <TextBlock Text="Drop log files to open" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Folders, .etl, .evtx, .log, .txt, .zip and more"
                               FontSize="13" Foreground="#CCFFFFFF" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Command palette (Ctrl+K): keyboard-first jump to any page/action. Overlays the whole window
             (RowSpan=4). Click the dimmed backdrop or press Esc to dismiss. -->
        <Grid x:Name="CommandPalettePanel" Grid.RowSpan="4" Visibility="Collapsed"
              Background="#66000000" Tapped="CommandPalettePanel_Tapped">
            <Border Width="640" MaxHeight="480" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,88,0,0" Padding="0" CornerRadius="8" Translation="0,0,48"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Border.Shadow><ThemeShadow/></Border.Shadow>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="CommandPaletteSearch" Grid.Row="0" Margin="12,12,12,8"
                             AutomationProperties.Name="Command palette search"
                             PlaceholderText="Type a command or page…"
                             TextChanged="CommandPaletteSearch_TextChanged"
                             KeyDown="CommandPaletteSearch_KeyDown"/>
                    <ListView x:Name="CommandPaletteList" Grid.Row="1" Margin="4,0,4,4" MaxHeight="360"
                              SelectionMode="Single" IsItemClickEnabled="True"
                              ItemClick="CommandPaletteList_ItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Padding" Value="8,2"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2" Margin="12,4,12,10" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="↑↓ to move · Enter to run · Esc to close"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
